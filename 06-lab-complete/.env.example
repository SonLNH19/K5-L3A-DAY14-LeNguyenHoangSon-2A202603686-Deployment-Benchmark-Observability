# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore — KHÔNG commit)
# Trên Railway/Render: đặt các biến này trong dashboard, không ghi vào code.

ENVIRONMENT=development
LOG_LEVEL=INFO
# Compose chuyển tiếp cùng cổng trên host và container.
PORT=8000

# Secret: đặt giá trị thật ở .env hoặc trên nền tảng deploy
AGENT_API_KEY=change-me

REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
